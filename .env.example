# Backend
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/placement_portal
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/placement_portal
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=placement-portal

# Optional: use local file storage when Supabase is not configured
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=./uploads

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Seed (development only)
SEED_DEMO_DATA=true

# Campus-only access (location radius around IIPS DAVV). Set false to develop from outside campus.
GEOFENCE_ENABLED=true
CAMPUS_LATITUDE=22.6884251
CAMPUS_LONGITUDE=75.876705
CAMPUS_RADIUS_M=500
CAMPUS_PASS_MINUTES=15
